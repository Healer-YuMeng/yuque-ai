## 复制为 .env 后填写（不要提交到 git）
APP_NAME=Enterprise RAG MVP
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

YUQUE_TOKEN=
# 可选：第二套语雀登录凭证（前端切换「当前登录身份」时使用；勿提交真实值）
YUQUE_TOKEN_SECONDARY=
YUQUE_SCOPE=
# 可选：第二套凭证对应的知识库作用域；不填则复用 YUQUE_SCOPE
YUQUE_SCOPE_SECONDARY=
YUQUE_BASE_URL=https://www.yuque.com/api/v2

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

LLM_PROVIDER=openai
LLM_MODEL=qwen3.6-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_SCORE_THRESHOLD=0.35

# 可选：启用 yuque-mcp-server 作为 fallback
YUQUE_MCP_COMMAND=
YUQUE_MCP_ARGS=
YUQUE_MCP_SEARCH_TOOL=yuque_search
YUQUE_MCP_GET_DOC_TOOL=yuque_get_doc
FORCE_MCP_FALLBACK=false
AUTO_MCP_TOOL_ROUTER=false

# 可选：启用 LLM 意图分类（directory/doc_list/content）
INTENT_LLM_ENABLED=false
INTENT_LLM_MODEL=qwen3.6-flash

# 可选：元问题（只问助手能力/边界）在正则未命中时，再调一次 LLM 分类（有延迟与费用；默认关闭）
ASSISTANT_META_LLM_ROUTER=false
ASSISTANT_META_ROUTER_MAX_CHARS=120
ASSISTANT_META_ROUTER_MODEL=qwen3.6-flash

# 未启用多模态时，是否仍将命中文档内的图片以 Markdown（/yuque/asset）追加进上下文（默认 true）
DOC_IMAGES_MARKDOWN_IN_CONTEXT=true
# 检索片段里抽不到图时，是否再拉全文抽图（易带入整篇所有插图；默认 false）
DOC_IMAGES_FULL_DOCUMENT_FALLBACK=false

# 可选：语雀文档图片/视频识读（独立多模态，默认关闭；推荐使用阿里百炼）
VISION_ENABLED=false
VISION_MODEL=qwen3.6-flash
VISION_MAX_IMAGES=4
VISION_MAX_VIDEOS=1
VISION_VIDEO_FPS=2
VISION_MAX_BYTES=4000000
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=

# V1.5 多媒体优先链路（默认关闭；开启后使用 /chat/v2 与 /chat/v2/stream）
CHAT_V15_ENABLED=false
CHAT_V15_MAX_IMAGES=3
CHAT_V15_MAX_VIDEOS=1
CHAT_V15_MAX_DOCS=6
CHAT_V15_IMAGE_RERANK_MODE=text_rerank
CHAT_V15_LEAD_NUDGE_ROUNDS=5
CHAT_V15_LEAD_NUDGE_STAY_S=120
CHAT_V15_GUIDE_REFRESH_S=300

# V3：会话画像 + 兴趣推荐（旁路，需同时 CHAT_V15_ENABLED 以加载 TOC）
CHAT_V3_ENABLED=false

# V4：目录状态机 + 目录内关联讲解（旁路，推荐在 V3 之上启用）
CHAT_V4_ENABLED=false
# V4 运行追踪：SSE done.debug.turn_trace（生产对客户建议 false）
EXPOSE_TURN_TRACE=true
# V4 试用账号池（JSON 数组，按 session_id 稳定分配）
# TRIAL_ACCOUNTS_JSON=[{"username":"demo_teacher","password":"请替换","label":"教师端试用"}]
TRIAL_ACCOUNTS_JSON=[]
# 文档插图多模态识读（V4 讲解时可选，需 VISION_API_KEY）
VISION_ENABLED=false
