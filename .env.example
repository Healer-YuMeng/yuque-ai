## 复制为 .env 后填写（不要提交到 git）
APP_NAME=Enterprise RAG MVP
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

YUQUE_TOKEN=
YUQUE_SCOPE=
YUQUE_BASE_URL=https://www.yuque.com/api/v2

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_SCORE_THRESHOLD=0.35

# 可选：启用 yuque-mcp-server 作为 fallback
YUQUE_MCP_COMMAND=
YUQUE_MCP_ARGS=
YUQUE_MCP_SEARCH_TOOL=search
YUQUE_MCP_GET_DOC_TOOL=get_doc
FORCE_MCP_FALLBACK=false
AUTO_MCP_TOOL_ROUTER=false

# 可选：启用 LLM 意图分类（directory/doc_list/content）
INTENT_LLM_ENABLED=false
INTENT_LLM_MODEL=deepseek-chat

