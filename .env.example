## 复制为 .env 后填写（不要提交到 git）
APP_NAME=Enterprise RAG MVP
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

YUQUE_TOKEN=
# 可选：第二套语雀登录凭证（前端切换「当前登录身份」时使用；勿提交真实值）
YUQUE_TOKEN_SECONDARY=
YUQUE_SCOPE=
# 可选：第二套凭证对应的知识库作用域；不填则复用 YUQUE_SCOPE
YUQUE_SCOPE_SECONDARY=
YUQUE_BASE_URL=https://www.yuque.com/api/v2

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_SCORE_THRESHOLD=0.35

# 可选：启用 yuque-mcp-server 作为 fallback
YUQUE_MCP_COMMAND=
YUQUE_MCP_ARGS=
YUQUE_MCP_SEARCH_TOOL=search
YUQUE_MCP_GET_DOC_TOOL=get_doc
FORCE_MCP_FALLBACK=false
AUTO_MCP_TOOL_ROUTER=false

# 可选：启用 LLM 意图分类（directory/doc_list/content）
INTENT_LLM_ENABLED=false
INTENT_LLM_MODEL=deepseek-chat

# 可选：元问题（只问助手能力/边界）在正则未命中时，再调一次 LLM 分类（有延迟与费用；默认关闭）
ASSISTANT_META_LLM_ROUTER=false
ASSISTANT_META_ROUTER_MAX_CHARS=120
ASSISTANT_META_ROUTER_MODEL=deepseek-chat

# 未启用多模态时，是否仍将命中文档内的图片以 Markdown（/yuque/asset）追加进上下文（默认 true）
DOC_IMAGES_MARKDOWN_IN_CONTEXT=true
# 检索片段里抽不到图时，是否再拉全文抽图（易带入整篇所有插图；默认 false）
DOC_IMAGES_FULL_DOCUMENT_FALLBACK=false

# 可选：语雀文档插图识读（独立多模态，默认关闭；需 OPENAI_API_KEY 或 VISION_API_KEY）
VISION_ENABLED=false
VISION_MODEL=gpt-4o-mini
VISION_MAX_IMAGES=4
VISION_MAX_BYTES=4000000
VISION_BASE_URL=
VISION_API_KEY=

